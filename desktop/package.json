{
  "name": "@persona/desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "PERSONA — applicazione desktop (Electron) che avvia il backend locale in-process",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "unpdf": "~1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "author": {
    "name": "fopearcano",
    "email": "fopearcano@users.noreply.github.com"
  },
  "homepage": "https://github.com/fopearcano/persona",
  "license": "UNLICENSED",
  "build": {
    "appId": "io.github.fopearcano.persona",
    "productName": "PERSONA",
    "copyright": "© fopearcano",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main.mjs",
      "package.json",
      "!**/node_modules/better-sqlite3/{deps,src}/**",
      "!**/node_modules/*/{test,tests,docs,example,examples}/**",
      "!**/*.{md,map,ts}"
    ],
    "extraResources": [
      {
        "from": "dist/web",
        "to": "web",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "dist/drizzle",
        "to": "drizzle"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "artifactName": "PERSONA-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "executableName": "persona",
      "synopsis": "Laboratorio di identità artificiali persistenti",
      "files": [
        "!**/node_modules/better-sqlite3/prebuilds/{darwin,win32,linuxmusl}-*"
      ],
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0",
        "libxss1",
        "libasound2 | libasound2t64"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!**/node_modules/better-sqlite3/prebuilds/{darwin,linux,linuxmusl}-*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "PERSONA-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "files": [
        "!**/node_modules/better-sqlite3/prebuilds/{linux,linuxmusl,win32}-*"
      ]
    },
    "dmg": {
      "artifactName": "PERSONA-${version}-mac-${arch}.${ext}"
    }
  },
  "desktopName": "persona.desktop"
}
